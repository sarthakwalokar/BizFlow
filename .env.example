# Root Environment Variables Template for BizFlow

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/bizflow_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT Configuration
# Note: In production, generate a secure 256-bit or 512-bit key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://bizflow-frontend-spa8.onrender.com

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8080/api/v1

# AI Business Assistant Configuration (Gemini, Groq, OpenRouter)
BIZFLOW_AI_ENABLED=true
BIZFLOW_AI_GEMINI_API_KEY=your_gemini_api_key_here
BIZFLOW_AI_GEMINI_MODEL=gemini-1.5-flash
BIZFLOW_AI_GROQ_API_KEY=your_groq_api_key_here
BIZFLOW_AI_OPENROUTER_API_KEY=your_openrouter_api_key_here
