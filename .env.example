# Root Environment Variables Template for BizFlow

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Supabase Transaction Pooler - Port 6543)
# URL Format: jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require&prepareThreshold=0
# Note: prepareThreshold=0 is required for PgBouncer / Supavisor transaction pooling
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.zwhhljorbjwueldcewmt
DB_PASSWORD=your_db_password

# HikariCP Connection Pool Configuration (Conservative Supabase Protection)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# Optional: Dedicated Flyway Migration Connection (Direct Connection)
# FLYWAY_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
# FLYWAY_USER=postgres
# FLYWAY_PASSWORD=your_db_password

# Security & JWT Configuration
# Note: In production, generate a secure 256-bit or 512-bit key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://bizflow-frontend-spa8.onrender.com

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8080/api/v1

# AI Business Assistant Configuration (Gemini, Groq, OpenRouter)
BIZFLOW_AI_ENABLED=true
BIZFLOW_AI_GEMINI_API_KEY=your_gemini_api_key_here
BIZFLOW_AI_GEMINI_MODEL=gemini-1.5-flash
BIZFLOW_AI_GROQ_API_KEY=your_groq_api_key_here
BIZFLOW_AI_OPENROUTER_API_KEY=your_openrouter_api_key_here
